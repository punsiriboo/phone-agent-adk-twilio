# Gemini API key (or set GOOGLE_GENAI_USE_VERTEXAI=TRUE with GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION)
GOOGLE_API_KEY=

# Used to validate Twilio webhook signatures and sign the stream token
TWILIO_AUTH_TOKEN=

# Public https URL Twilio reaches, e.g. your ngrok or Cloud Run URL
PUBLIC_BASE_URL=

# Optional
# LIVE_MODEL=gemini-3.1-flash-live-preview
# LIVE_VOICE=Zephyr
# LIVE_LANGUAGE=en-US
# MAX_CALL_SECONDS=600
# LOG_LEVEL=INFO
# ENABLE_WEB_CLIENT=true   # browser test client at /web (keep off in production)
